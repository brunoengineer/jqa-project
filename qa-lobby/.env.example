# Copy to .env.local and fill in only the providers you use. Restart `npm run dev` after changes.
# Nothing here is needed for Ollama, Claude (your plan), or Copilot (your plan) after /login.

# --- Claude (your plan) ---
# Auto-detected (PATH, ~/.local/bin, or the Claude Code VS Code extension). Override if needed:
# CLAUDE_CODE_PATH=C:\path\to\claude.exe

# --- Claude API (pay per use) ---
# ANTHROPIC_API_KEY=sk-ant-...

# --- GitHub Copilot ---
# Not needed if you signed in once with `npx @github/copilot` → /login.
# Otherwise: a fine-grained personal access token with the "Copilot Requests" permission.
# COPILOT_GITHUB_TOKEN=github_pat_...

# --- OpenAI ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Ollama (local) ---
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_NUM_CTX=8192

# Fallback provider for API calls that omit `provider` (ollama | claude | copilot | openai)
# LLM_PROVIDER=ollama
